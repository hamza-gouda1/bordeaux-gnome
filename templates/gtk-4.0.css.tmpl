/* Bordeaux Design System - ${variant} GTK4 / Libadwaita (${description}) */
@define-color accent_color ${accent-text};
@define-color accent_bg_color ${accent};
@define-color accent_fg_color ${on-accent};
@define-color destructive_color ${danger};
@define-color destructive_bg_color ${danger};
@define-color destructive_fg_color ${on-status};
@define-color success_color ${success};
@define-color success_bg_color ${success};
@define-color success_fg_color ${on-status};
@define-color warning_color ${warning};
@define-color warning_bg_color ${warning};
@define-color warning_fg_color ${on-status};
@define-color error_color ${danger};
@define-color error_bg_color ${danger};
@define-color error_fg_color ${on-status};

@define-color window_bg_color ${bg-1};
@define-color window_fg_color ${fg-0};
@define-color view_bg_color ${bg-2};
@define-color view_fg_color ${fg-0};
@define-color headerbar_bg_color ${bg-1};
@define-color headerbar_fg_color ${fg-0};
@define-color headerbar_border_color ${border};
@define-color headerbar_backdrop_color ${bg-1};
@define-color sidebar_bg_color ${sidebar};
@define-color sidebar_fg_color ${fg-0};
@define-color sidebar_border_color ${border};
@define-color sidebar_backdrop_color ${sidebar};

@define-color card_bg_color ${bg-2};
@define-color card_fg_color ${fg-0};
@define-color card_border_color ${border};
@define-color popover_bg_color ${bg-2};
@define-color popover_fg_color ${fg-0};
@define-color dialog_bg_color ${bg-1};
@define-color dialog_fg_color ${fg-0};

/* Custom Bordeaux Refinements */
* {
    font-family: ${font-sans};
}

window, window.background {
    background-color: @window_bg_color;
    color: @window_fg_color;
}

headerbar {
    min-height: ${header-h};
    font-weight: ${fw-semibold};
    background-color: @headerbar_bg_color;
    color: @headerbar_fg_color;
    border-bottom: 1px solid @headerbar_border_color;
    box-shadow: none;
}

button {
    font-weight: ${fw-semibold};
    border-radius: ${r-sm};
}

.card, card {
    background-color: @card_bg_color;
    color: @card_fg_color;
    border: 1px solid @card_border_color;
    border-radius: ${r-md};
    box-shadow: ${elev-1};
}

button.suggested-action, .suggested-action button {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
    border-radius: ${r-pill};
    font-weight: ${fw-semibold};
}

button.suggested-action:hover {
    background-color: ${accent-hi};
}

button.suggested-action:active {
    background-color: ${accent-press};
}

entry, textview {
    background-color: @view_bg_color;
    color: @view_fg_color;
    border-color: @card_border_color;
    border-radius: ${r-sm};
}

/* Gold marks place: a hairline focus ring with a soft bloom, keyboard only. */
button:focus-visible,
entry:focus-within,
row:focus-visible,
switch:focus-visible {
    outline: 1px solid ${focus};
    outline-offset: 3px;
    box-shadow: 0 0 0 6px ${ring-glow};
}

/* Sidebar location: tile fill only, no gold strip, no burgundy. */
.navigation-sidebar row:selected,
.sidebar-pane row:selected {
    background-color: ${tile};
    color: @sidebar_fg_color;
}
