# Bordeaux Plymouth Script
Window.SetBackgroundTopColor(0.063, 0.027, 0.035); # #100709
Window.SetBackgroundBottomColor(0.110, 0.047, 0.067); # #1C0C11

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + (Window.GetWidth() - logo.image.GetWidth()) / 2;
logo.y = Window.GetY() + (Window.GetHeight() - logo.image.GetHeight()) / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);
logo.sprite.SetOpacity(1.0);

progress_bar.image = Image("progress_bar.png");
progress_bar.sprite = Sprite(progress_bar.image);
progress_bar.x = Window.GetX() + (Window.GetWidth() - progress_bar.image.GetWidth()) / 2;
progress_bar.y = logo.y + logo.image.GetHeight() + 40;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 10);
progress_bar.sprite.SetOpacity(0.85);

fun progress_callback (duration, progress) {
    if (progress_bar.image) {
        # Smooth progress indicator
    }
}
Plymouth.SetBootProgressFunction(progress_callback);
