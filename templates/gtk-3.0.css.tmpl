/* Bordeaux Design System - ${variant} GTK3 Overrides (${description}) */
@define-color theme_selected_bg_color ${accent};
@define-color theme_selected_fg_color ${on-accent};

* {
    font-family: ${font-sans};
}

headerbar {
    min-height: ${header-h};
    font-weight: ${fw-semibold};
}

button {
    font-weight: ${fw-semibold};
    border-radius: ${r-sm};
}

button:checked, button.suggested-action {
    background-color: ${accent};
    background-image: none;
    color: ${on-accent};
}

entry {
    border-radius: ${r-sm};
}

/* Gold hairline focus ring (GTK3 has no :focus-visible). */
button:focus,
entry:focus {
    outline: 1px solid ${focus};
    outline-offset: 3px;
}
