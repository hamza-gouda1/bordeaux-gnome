/* ==============================================================================
 * Bordeaux Design System - GNOME Shell stylesheet, ${variant} (${description})
 * "Hallmark": glass slabs with a gold top edge, a darker lip, a cut top-left
 * corner and one box-shadow. Tested target: GNOME 46 (Wayland), Ubuntu 24.04.
 * St notes: one box-shadow per node, no text-transform, no CSS variables.
 * ============================================================================== */

/* Stage Root & Base Typography */
stage {
    font-family: ${font-sans};
    font-size: ${fs-body};
    font-weight: ${fw-semibold};
}

/* ==============================================================================
 * 1. TOP BAR (#panel) - transparent strut holding three capsules
 * ============================================================================== */
#panel {
    background-color: transparent !important;
    border-bottom: none !important;
    box-shadow: none !important;
    color: ${fg-0};
    font-family: ${font-sans};
    font-size: ${fs-body};
    font-weight: ${fw-semibold} !important;
    height: ${panel-h} !important;
    transition-duration: ${dur-std};
}

/* Left, centre and right groups become the three island capsules. */
#panelLeft,
#panelCenter,
#panelRight {
    background-color: ${glass};
    border: 1px solid ${border};
    border-top-color: ${gold-faint};
    border-radius: ${r-island};
    box-shadow: ${elev-1};
    margin: ${island-mt} 0;
    padding: 0 ${sp-1};
}

#panelLeft {
    margin-left: ${sp-3};
}

#panelRight {
    margin-right: ${sp-3};
}

#panel .panel-button {
    color: ${fg-0};
    font-family: ${font-sans};
    font-size: ${fs-body};
    font-weight: ${fw-semibold} !important;
    padding: 0 ${sp-2};
    margin: 0 1px;
    border-radius: ${r-md} !important;
    transition-duration: ${dur-fast};
}

#panel .panel-button .system-status-icon {
    icon-size: 16px;
    padding: 0 3px;
    margin: 0 1px;
}

#panel .panel-button:hover {
    background-color: ${hover};
    color: ${fg-0};
    border-radius: ${r-md} !important;
    box-shadow: none;
}

#panel .panel-button:active,
#panel .panel-button:overview,
#panel .panel-button:focus,
#panel .panel-button:checked {
    background-color: ${accent};
    color: ${on-accent};
    border-radius: ${r-md} !important;
    box-shadow: none;
}

/* Clock Display: Geist Mono with a wide tracking, like the eyebrow labels. */
#panel .clock-display {
    font-family: ${font-mono};
    font-weight: ${fw-medium};
    font-size: ${fs-eyebrow};
    letter-spacing: ${ls-eyebrow};
    color: ${fg-1};
    border-radius: ${r-md} !important;
}

/* The label itself: Yaru styles `.panel-button.clock-display .clock`, so name the
   leaf too. Geist Mono is fixed-width; "tnum" keeps it so if the font falls back. */
#panel .panel-button.clock-display .clock {
    font-family: ${font-mono};
    font-weight: ${fw-medium};
    font-size: ${fs-eyebrow};
    letter-spacing: ${ls-eyebrow};
    font-feature-settings: "tnum";
    color: ${fg-1};
}

#panel .clock-display:hover,
#panel .panel-button.clock-display:hover .clock {
    color: ${fg-0};
}

/* Workspace indicator: gold ticks (the shell stretches the active one). */
#panel .panel-button#panelActivities .workspace-dot,
#panel:overview .panel-button#panelActivities .workspace-dot {
    background-color: ${gold};
    border-radius: 1px;
    min-width: 5px;
    min-height: 2px;
}

/* ==============================================================================
 * 2. QUICK SETTINGS & POPOVERS - glass slab, matte tiles, burgundy for state
 * ============================================================================== */
.popup-menu-content,
.quick-settings {
    background-gradient-direction: vertical;
    background-gradient-start: ${slab-top};
    background-gradient-end: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-slab} !important;
    padding: ${sp-3};
    box-shadow: ${elev-4};
    font-size: ${fs-body};
}

.quick-settings-grid {
    spacing-rows: ${sp-2};
    spacing-columns: ${sp-2};
}

/* Inactive Toggle State */
.quick-toggle,
.quick-menu-toggle .quick-toggle {
    background-color: ${tile};
    color: ${fg-0};
    border-radius: ${r-lg} !important;
    border: 1px solid ${border};
    min-height: 58px;
    transition-duration: ${dur-fast};
}

.quick-toggle:hover,
.quick-menu-toggle .quick-toggle:hover {
    background-color: ${bg-3};
    border-color: ${gold-faint};
    color: ${fg-0};
}

.quick-toggle:focus,
.quick-menu-toggle .quick-toggle:focus {
    border-color: ${focus};
}

/* Active / Checked Toggle State: burgundy marks state, never blue */
.quick-toggle:checked,
.quick-toggle:focus:checked,
.quick-toggle:hover:checked,
.quick-toggle:active:checked,
.quick-menu-toggle .quick-toggle:checked,
.quick-menu-toggle .quick-toggle-arrow:checked {
    background-color: ${accent} !important;
    color: ${on-accent} !important;
    border: 1px solid ${accent-hi} !important;
    box-shadow: none !important;
}

.quick-menu-toggle .quick-toggle-arrow {
    background-color: ${tile};
    color: ${fg-0};
    border-radius: 0 ${r-lg} ${r-lg} 0 !important;
    border-left: 1px solid ${border};
}

.quick-toggle .quick-toggle-title {
    font-family: ${font-sans};
    font-weight: ${fw-semibold};
    font-size: ${fs-body};
    color: ${fg-0};
}

.quick-toggle:checked .quick-toggle-title {
    color: ${on-accent};
}

.quick-toggle StBoxLayout > .quick-toggle-subtitle {
    font-family: ${font-mono};
    font-weight: ${fw-regular};
    font-size: ${fs-caption};
    color: ${fg-1};
}

.quick-toggle:checked StBoxLayout > .quick-toggle-subtitle {
    color: ${on-accent@85};
}

.quick-toggle-menu .header .icon.active {
    background-color: ${accent} !important;
    color: ${on-accent} !important;
}

/* Sliders (Volume, Brightness) */
.slider {
    -barlevel-height: 6px;
    -barlevel-background-color: ${bg-4};
    -barlevel-border-width: 0;
    -barlevel-active-background-color: ${accent};
    -barlevel-overdrive-color: ${gold};
    -slider-handle-radius: 8px;
    -slider-handle-border-width: 1px;
    -slider-handle-border-color: ${gold-line};
}

/* Popover Menu Items */
.popup-menu-item {
    color: ${fg-0};
    font-family: ${font-sans};
    border-radius: ${r-md} !important;
    padding: ${sp-1} ${sp-3};
    font-size: ${fs-body};
    font-weight: ${fw-semibold};
}

.popup-menu-item:hover,
.popup-menu-item:selected,
.popup-menu-item:focus {
    background-color: ${accent};
    color: ${on-accent};
}

/* Date & Notification Popover (#calendarArea, .message-list, .calendar) */
#calendarArea {
    padding: ${sp-2};
}

.datemenu-popover {
    border-radius: ${r-slab} !important;
}

.datemenu-today-button .day-label {
    font-family: ${font-mono} !important;
    font-size: ${fs-eyebrow} !important;
    font-weight: ${fw-medium} !important;
    letter-spacing: ${ls-eyebrow};
    color: ${gold-text} !important;
}

.datemenu-today-button .date-label {
    font-family: ${font-sans} !important;
    font-size: ${fs-heading} !important;
    font-weight: ${fw-semibold} !important;
    color: ${fg-0} !important;
}

/* Calendar month & days */
.calendar .calendar-month-header .calendar-month-label {
    font-family: ${font-sans} !important;
    font-size: ${fs-body} !important;
    font-weight: ${fw-semibold} !important;
    color: ${fg-0} !important;
}

.calendar .calendar-day-heading {
    font-family: ${font-mono} !important;
    font-size: ${fs-eyebrow} !important;
    font-weight: ${fw-medium} !important;
    letter-spacing: ${ls-eyebrow};
    color: ${gold-text} !important;
}

.calendar .calendar-day {
    font-family: ${font-mono} !important;
    font-size: ${fs-body} !important;
    font-weight: ${fw-medium} !important;
    border-radius: ${r-pill} !important;
}

.calendar .calendar-day.calendar-today {
    background-color: ${accent} !important;
    color: ${on-accent} !important;
    border: 1px solid ${gold-line} !important;
    border-radius: ${r-pill} !important;
}

/* Message List & Notifications */
.message-list {
    border: none !important;
}

.message-list-section,
.message-list-sections {
    spacing: ${sp-2};
}

.message {
    background-color: ${matte} !important;
    border: 1px solid ${border} !important;
    border-top-color: ${gold-faint} !important;
    border-radius: ${r-md} !important;
    box-shadow: ${elev-1} !important;
    padding: ${sp-1} !important;
    margin: ${sp-1} 0 !important;
}

.message:hover {
    background-color: ${tile} !important;
    border-color: ${gold-faint} !important;
}

.message .message-header {
    color: ${fg-2} !important;
    padding: 2px ${sp-1} !important;
}

.message .message-header .message-source-title {
    font-family: ${font-mono} !important;
    font-size: ${fs-eyebrow} !important;
    font-weight: ${fw-medium} !important;
    letter-spacing: ${ls-eyebrow};
    color: ${fg-2} !important;
}

.message .message-header .event-time {
    font-family: ${font-mono} !important;
    font-size: ${fs-eyebrow} !important;
    font-weight: ${fw-medium} !important;
    color: ${fg-2} !important;
}

.message .message-box .message-content .message-title {
    font-family: ${font-sans} !important;
    font-size: ${fs-title} !important;
    font-weight: ${fw-semibold} !important;
    color: ${fg-0} !important;
}

.message .message-box .message-content .message-body,
.message .message-box .message-content StLabel {
    font-family: ${font-sans} !important;
    font-size: ${fs-body} !important;
    font-weight: ${fw-medium} !important;
    color: ${fg-1} !important;
}

.message-list-controls {
    color: ${fg-0} !important;
    font-family: ${font-sans} !important;
    font-size: ${fs-body} !important;
    font-weight: ${fw-semibold} !important;
}

.message-list-controls .button {
    background-color: ${tile} !important;
    color: ${fg-0} !important;
    border: 1px solid ${border} !important;
    border-radius: ${r-pill} !important;
    padding: ${sp-1} ${sp-3} !important;
    font-family: ${font-sans} !important;
    font-size: ${fs-body} !important;
    font-weight: ${fw-semibold} !important;
}

.message-list-controls .button:hover {
    background-color: ${accent} !important;
    color: ${on-accent} !important;
    border-color: ${accent-hi} !important;
}

/* ==============================================================================
 * 3. DASH-TO-DOCK (Left Dock) - a slab: gold top edge, lip, cut corner
 * ============================================================================== */
#dashtodockContainer {
    background-color: transparent;
}

#dashtodockContainer #dash {
    padding: 0;
    margin: 0;
}

/* Yaru and the extension both style `#dashtodockContainer.left[.fixed][.shrink] #dash
   .dash-background` with more specificity than this rule, and they set margin 4px.
   !important on every property is what makes the float margin and the glass stick.
   The extension reserves the margin in the work area, so windows keep a real gap. */
#dashtodockContainer.left #dash .dash-background {
    background-color: transparent !important;
    background-gradient-direction: vertical !important;
    background-gradient-start: ${slab-top} !important;
    background-gradient-end: ${glass} !important;
    border: 1px solid ${border} !important;
    border-top-color: ${gold-line} !important;
    border-bottom-color: ${lip} !important;
    box-shadow: ${elev-4} !important;
    border-radius: ${r-slab} !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    margin-left: ${sp-3} !important;
    margin-right: ${sp-2} !important;
    padding: ${sp-3} 0 !important;
}

#dashtodockContainer.left.extended #dash .dash-background {
    border-radius: ${r-lg} !important;
}

#dashtodockContainer .dash-item-container {
    margin: 0 !important;
    padding: 0 !important;
}

#dashtodockContainer .dash-item-container > StButton,
#dashtodockContainer .dash-item-container .app-well-app,
#dashtodockContainer .dash-item-container .show-apps,
#dashtodockContainer .dash-item-container .overview-tile {
    padding: 3px !important;
    margin: 2px 2px !important;
    min-width: 0 !important;
    max-width: 9999px !important;
    border-radius: ${r-md} !important;
    border: none !important;
    background-color: transparent !important;
    box-shadow: none !important;
}

#dashtodockContainer .dash-item-container .overview-icon,
#dashtodockContainer .app-well-app .overview-icon,
#dashtodockContainer .show-apps .overview-icon,
#dashtodockContainer .overview-tile .overview-icon {
    padding: 2px !important;
    margin: 0 !important;
    min-width: 0 !important;
    max-width: 9999px !important;
    border-radius: ${r-md} !important;
    border: none !important;
    box-shadow: none !important;
}

#dashtodockContainer .dash-item-container .app-well-app:hover .overview-icon,
#dashtodockContainer .dash-item-container .show-apps:hover .overview-icon,
#dashtodockContainer .dash-item-container .overview-tile:hover {
    background-color: ${hover} !important;
    border: none !important;
    border-radius: ${r-md} !important;
    box-shadow: none !important;
}

#dashtodockContainer .dash-separator {
    background-color: ${gold-line} !important;
    height: 1px !important;
    margin: ${sp-1} 6px !important;
}

/* Running app. Yaru colours `#dash .dash-item-container .app-grid-running-dot`
   orange (#d34615, higher specificity), so !important is required here.
   With running-indicator-style DASHES (set by the preset) ubuntu-dock draws the
   indicator on the dock's inner edge from this dot's background-color: fg-2 for
   running apps, gold for the focused one. With style DEFAULT it is this 4px dot. */
#dashtodockContainer .app-grid-running-dot,
#dashtodockContainer .app-well-app-running-dot {
    background-color: ${fg-2} !important;
    width: 4px !important;
    height: 4px !important;
    margin: 0 2px !important;
    border-width: 0 !important;
}

#dashtodockContainer .app-well-app.focused .app-grid-running-dot,
#dashtodockContainer .app-well-app.focused .app-well-app-running-dot {
    background-color: ${gold} !important;
}

/* App Notification Counter & Badges */
#dashtodockContainer .notification-badge,
#dashtodockContainer.left .notification-badge,
#dashtodockContainer.bottom .notification-badge,
#dashtodockContainer.top .notification-badge,
#dashtodockContainer.right .notification-badge {
    background-color: ${accent} !important;
    color: ${on-accent} !important;
    border: 1px solid ${gold-line} !important;
    box-shadow: ${elev-1} !important;
    border-radius: ${r-pill} !important;
    font-family: ${font-mono} !important;
    font-weight: ${fw-semibold} !important;
    font-size: ${fs-eyebrow} !important;
    min-width: 16px !important;
    max-width: 24px !important;
    min-height: 16px !important;
    max-height: 18px !important;
    padding: 0 ${sp-1} !important;
    margin: 1px 2px !important;
    text-align: center !important;
}

#dashtodockContainer .number-overlay {
    color: ${fg-0} !important;
    background-color: ${glass-strong} !important;
    border: 1px solid ${gold-line} !important;
    border-radius: ${r-pill} !important;
    font-family: ${font-mono} !important;
    font-weight: ${fw-semibold} !important;
    text-align: center !important;
}

/* ==============================================================================
 * 4. APP GRID & FOLDER ICONS
 * ============================================================================== */
.icon-grid {
    row-spacing: ${sp-4};
    column-spacing: 20px;
    max-row-spacing: 36px;
    max-column-spacing: 44px;
    page-padding-top: ${sp-5};
    page-padding-bottom: ${sp-5};
    page-padding-left: 28px;
    page-padding-right: 28px;
}

.overview-tile,
.grid-search-result,
#appDisplay .overview-tile,
#appDisplay .app-well-app,
.app-folder-dialog .overview-tile,
.app-folder-dialog .app-well-app {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    font-size: ${fs-body};
    font-weight: ${fw-semibold};
    border-radius: ${r-lg} !important;
    padding: ${sp-2} 10px;
    min-width: 120px;
    max-width: 175px;
    text-align: center;
    transition-duration: ${dur-fast};
}

.overview-tile .overview-icon,
.grid-search-result .overview-icon,
.app-well-app .overview-icon,
.show-apps .overview-icon,
#appDisplay .overview-icon,
.app-folder-dialog .app-well-app .overview-icon,
.app-folder .overview-icon {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

.overview-tile .overview-icon.overview-icon-with-label > StBoxLayout,
.grid-search-result .overview-icon.overview-icon-with-label > StBoxLayout {
    spacing: 6px;
}

/* App Name Label Styling */
.overview-icon StLabel,
.overview-tile StLabel,
#appDisplay StLabel,
.app-folder StLabel {
    font-family: ${font-sans};
    font-size: ${fs-body};
    font-weight: ${fw-semibold};
    color: ${fg-0};
    text-align: center;
    min-width: 110px;
    max-width: 175px;
}

/* Hover & Active States */
#appDisplay .overview-tile:hover,
#appDisplay .app-well-app:hover,
.app-folder-dialog .overview-tile:hover,
.app-folder-dialog .app-well-app:hover,
.overview-tile:hover,
.grid-search-result:hover {
    background-color: ${hover} !important;
    border: 1px solid ${border} !important;
    border-radius: ${r-lg} !important;
    box-shadow: none !important;
}

#appDisplay .overview-tile:focus,
#appDisplay .app-well-app:focus,
.overview-tile:focus {
    border: 1px solid ${focus} !important;
}

#appDisplay .overview-tile:active,
#appDisplay .app-well-app:active,
.overview-tile:active {
    background-color: ${press} !important;
    border: 1px solid ${border} !important;
    border-radius: ${r-lg} !important;
}

/* Folders: a smaller slab */
.app-folder {
    background-color: ${glass} !important;
    border: 1px solid ${border} !important;
    border-top-color: ${gold-line} !important;
    border-bottom-color: ${lip} !important;
    box-shadow: ${elev-2} !important;
    border-radius: ${r-slab} !important;
    min-width: 120px;
    max-width: 175px;
}

.app-folder:hover {
    background-color: ${glass-strong} !important;
    border-color: ${gold-faint} !important;
    border-top-color: ${gold} !important;
    box-shadow: ${elev-3} !important;
}

/* App Folder Dialog */
.app-folder-dialog {
    background-color: ${glass-strong} !important;
    border: 1px solid ${border} !important;
    border-top-color: ${gold-line} !important;
    border-bottom-color: ${lip} !important;
    border-radius: ${r-slab} !important;
    box-shadow: ${elev-4} !important;
}

.app-folder-dialog .folder-name-container .folder-name-entry {
    font-family: ${font-sans};
    font-size: ${fs-heading};
    font-weight: ${fw-semibold};
    color: ${fg-0};
    background-color: ${bg-2};
    border: 1px solid ${border};
    border-radius: ${r-sm};
}

/* Search Entry */
.search-entry {
    background-color: ${glass} !important;
    color: ${fg-0};
    font-family: ${font-sans};
    border: 1px solid ${border} !important;
    border-radius: ${r-pill} !important;
    padding: ${sp-2} 18px;
    font-size: ${fs-body-lg};
    font-weight: ${fw-semibold};
    box-shadow: none !important;
}

.search-entry:focus {
    border-color: ${focus};
    box-shadow: 0 0 6px ${ring-glow};
}

/* Modal Dialogs: slab */
.modal-dialog {
    background-gradient-direction: vertical;
    background-gradient-start: ${slab-top};
    background-gradient-end: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-slab};
    box-shadow: ${elev-4};
}

/* ==============================================================================
 * 5. NEW SURFACES (all slabs share: glass-strong gradient, gold top edge, lip)
 * ============================================================================== */

/* ---- Dock: running + active ticks (ubuntu-dock reads the dot's background) ---- */
#dashtodockContainer .app-well-app.focused .overview-icon {
    background-color: ${tile} !important;
    border-radius: ${r-md} !important;
}

#dashtodockContainer .dash-item-container .app-well-app:focus .overview-icon {
    border: 1px solid ${focus} !important;
}

/* ---- Tooltips: small slab ---- */
.dash-label,
.window-caption,
.screenshot-ui-tooltip {
    background-color: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-cut} ${r-sm} ${r-sm} ${r-sm};
    box-shadow: ${elev-2};
    padding: ${sp-1} ${sp-3};
    font-family: ${font-sans};
    font-size: ${fs-body};
    font-weight: ${fw-semibold};
}

/* ---- OSD: volume / brightness slab ---- */
.osd-window {
    background-gradient-direction: vertical;
    background-gradient-start: ${slab-top};
    background-gradient-end: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-slab};
    box-shadow: ${elev-4};
    padding: ${sp-3} ${sp-5};
    font-family: ${font-mono};
    font-weight: ${fw-medium};
}

.osd-window .level {
    -barlevel-height: 6px;
    -barlevel-background-color: ${bg-4};
    -barlevel-border-width: 0;
    -barlevel-active-background-color: ${accent};
    -barlevel-active-border-width: 0;
    -barlevel-overdrive-color: ${danger};
    -barlevel-overdrive-separator-width: 2px;
}

.osd-monitor-label {
    background-color: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-radius: ${r-slab};
    font-family: ${font-mono};
    font-weight: ${fw-medium};
}

/* ---- Alt-Tab: slab list, the current item gets a gold tick underneath ---- */
.switcher-list {
    background-gradient-direction: vertical;
    background-gradient-start: ${slab-top};
    background-gradient-end: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-slab};
    box-shadow: ${elev-4};
    padding: ${sp-3};
}

.switcher-list .item-box {
    background-color: transparent;
    color: ${fg-0};
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    border-radius: ${r-lg};
}

.switcher-list .item-box:hover {
    background-color: ${hover};
}

.switcher-list .item-box:focus {
    border-color: ${focus};
    box-shadow: none !important;
    background-color: ${hover};
}

.switcher-list .item-box:selected,
.switcher-list .item-box:highlighted,
.switcher-list .item-box:checked {
    background-color: ${tile};
    color: ${fg-0};
    border-color: ${border};
    border-bottom-color: ${gold};
}

.switcher-list .item-box:selected:hover {
    background-color: ${bg-3};
}

.switcher-list .separator {
    background-color: ${border};
}

.switcher-list .thumbnail-box {
    padding: ${sp-1};
    spacing: ${sp-2};
}

.switcher-list .thumbnail {
    border-radius: ${r-sm};
}

.switcher-arrow {
    border-color: ${fg-2};
    color: ${fg-2};
}

.switcher-arrow:highlighted {
    border-color: ${fg-0};
    color: ${fg-0};
}

.input-source-switcher-symbol {
    font-family: ${font-mono};
    color: ${fg-0};
}

.cycler-highlight {
    border: 2px solid ${focus};
}

.resize-popup {
    background-color: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-radius: ${r-cut} ${r-sm} ${r-sm} ${r-sm};
    font-family: ${font-mono};
}

/* ---- Workspace switcher popup: thin gold ticks ---- */
.workspace-switcher {
    background-gradient-direction: vertical;
    background-gradient-start: ${slab-top};
    background-gradient-end: ${glass-strong};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-slab};
    box-shadow: ${elev-3};
    padding: ${sp-2} ${sp-4};
}

.ws-switcher-indicator {
    background-color: ${fg-2};
    border-radius: 1px;
    padding: 1px 3px;
    margin: ${sp-3} ${sp-1};
}

.ws-switcher-indicator:active {
    background-color: ${gold};
    padding: 1px 10px;
    margin: ${sp-3} ${sp-1};
}

/* ---- Popup menus: panel menu, app menu, input-method candidates ---- */
.popup-menu {
    color: ${fg-0};
}

.popup-menu-boxpointer,
.candidate-popup-boxpointer {
    -arrow-rise: 0px;
}

.candidate-popup-content {
    background-gradient-direction: vertical;
    background-gradient-start: ${slab-top};
    background-gradient-end: ${glass-strong};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-slab};
    box-shadow: ${elev-3};
}

.candidate-index {
    color: ${fg-2};
    font-family: ${font-mono};
}

.candidate-box {
    border-radius: ${r-sm};
    color: ${fg-0};
}

.candidate-box:selected,
.candidate-box:hover {
    background-color: ${sel};
    color: ${fg-0};
}

.popup-sub-menu {
    background-color: ${matte};
    border: 1px solid ${border};
    border-radius: ${r-md};
}

.popup-menu-item:checked {
    background-color: ${sel};
    color: ${accent-text};
}

.popup-menu-item:insensitive {
    color: ${fg-2};
}

.popup-separator-menu-item .popup-separator-menu-item-separator {
    background-color: ${border};
    height: 1px;
}

.popup-menu.panel-menu {
    margin-bottom: ${sp-2};
}

.app-menu {
    max-width: 27em;
}

.app-menu .popup-inactive-menu-item:first-child > StLabel {
    color: ${fg-2};
    font-family: ${font-mono};
    font-size: ${fs-eyebrow};
    letter-spacing: ${ls-eyebrow};
}

/* ---- Notification banners (also .message above): eyebrow, title, split footer ---- */
.notification-banner {
    background-gradient-direction: vertical !important;
    background-gradient-start: ${slab-top} !important;
    background-gradient-end: ${glass-strong} !important;
    border: 1px solid ${border} !important;
    border-top-color: ${gold-line} !important;
    border-bottom-color: ${lip} !important;
    border-radius: ${r-slab} !important;
    box-shadow: ${elev-4} !important;
    padding: ${sp-1} 0 0 0 !important;
    margin: ${sp-2} !important;
}

.notification-banner:hover {
    border-color: ${gold-faint} !important;
    border-top-color: ${gold} !important;
}

.notification-buttons-bin {
    spacing: 0;
    border-top: 1px solid ${border};
}

.notification-button {
    background-color: transparent;
    color: ${fg-1};
    font-family: ${font-sans};
    font-size: ${fs-body};
    font-weight: ${fw-semibold};
    padding: ${sp-3};
    margin: 0;
    border-radius: 0;
    border: none;
    border-left: 1px solid ${border};
}

.notification-button:first-child {
    color: ${accent-text};
    border-left: none;
    border-radius: 0 0 0 ${r-xl};
}

.notification-button:last-child {
    border-radius: 0 0 ${r-xl} 0;
}

.notification-button:hover {
    background-color: ${hover};
    color: ${fg-0};
}

.notification-button:first-child:hover {
    color: ${accent-text};
}

.notification-button:focus {
    background-color: ${hover};
    box-shadow: none !important;
}

.notification-button:active {
    background-color: ${press};
}

/* ---- Modal and end-session dialogs ---- */
.modal-dialog .modal-dialog-content-box {
    margin: ${sp-5} ${sp-6};
    spacing: ${sp-5};
}

.message-dialog-content .message-dialog-title {
    font-family: ${font-sans};
    font-size: ${fs-title};
    font-weight: ${fw-semibold};
    color: ${fg-0};
}

.message-dialog-content .message-dialog-description {
    font-family: ${font-sans};
    font-size: ${fs-body};
    color: ${fg-1};
}

.end-session-dialog .end-session-dialog-battery-warning,
.end-session-dialog .dialog-list-title {
    color: ${warning};
}

.dialog-list .dialog-list-title {
    font-family: ${font-mono};
    font-size: ${fs-eyebrow};
    letter-spacing: ${ls-eyebrow};
    color: ${fg-2};
}

.dialog-list .dialog-list-box .dialog-list-item .dialog-list-item-title {
    color: ${fg-0};
}

.dialog-list .dialog-list-box .dialog-list-item .dialog-list-item-description {
    color: ${fg-1};
}

.modal-dialog .modal-dialog-linked-button {
    background-color: transparent;
    color: ${fg-1};
    font-family: ${font-sans};
    font-size: ${fs-body};
    font-weight: ${fw-semibold} !important;
    padding: ${sp-3} ${sp-4};
    margin: 0;
    border-radius: 0;
    border-top: 1px solid ${border};
    border-left: 1px solid ${border};
}

.modal-dialog .modal-dialog-linked-button:first-child {
    border-left: none;
    border-radius: 0 0 0 ${r-xl};
}

.modal-dialog .modal-dialog-linked-button:last-child {
    color: ${accent-text};
    border-radius: 0 0 ${r-xl} 0;
}

.modal-dialog .modal-dialog-linked-button:hover {
    background-color: ${hover};
    color: ${fg-0};
}

.modal-dialog .modal-dialog-linked-button:last-child:hover {
    color: ${accent-text};
}

.modal-dialog .modal-dialog-linked-button:focus {
    background-color: ${hover};
    box-shadow: none !important;
}

.modal-dialog .modal-dialog-linked-button:active {
    background-color: ${press};
}

.run-dialog .run-dialog-entry,
.prompt-dialog-password-entry {
    background-color: ${bg-2};
    color: ${fg-0};
    border: 1px solid ${border};
    border-radius: ${r-sm};
}

.prompt-dialog-error-label {
    color: ${danger};
}

.prompt-dialog-info-label,
.prompt-dialog-null-label {
    color: ${fg-1};
}

/* ---- Search results ---- */
#searchResults {
    margin: 0 ${sp-1};
}

.search-section-content {
    background-color: ${matte};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-faint};
    border-radius: ${r-md};
    padding: ${sp-2};
    margin: 0 ${sp-3};
}

.list-search-result,
.search-provider-icon {
    background-color: transparent;
    color: ${fg-0};
    border: 1px solid transparent;
    border-radius: ${r-md};
}

.list-search-result:hover,
.search-provider-icon:hover {
    background-color: ${hover};
}

.list-search-result:focus,
.search-provider-icon:focus {
    background-color: ${hover};
    border-color: ${focus};
    box-shadow: none !important;
}

.list-search-result:selected,
.list-search-result:highlighted,
.search-provider-icon:selected,
.search-provider-icon:highlighted {
    background-color: ${sel};
    color: ${fg-0};
}

.list-search-result .list-search-result-title {
    font-weight: ${fw-semibold};
    color: ${fg-0};
}

.list-search-result .list-search-result-description,
.search-statustext {
    color: ${fg-2};
}

.search-provider-icon .list-search-provider-content .list-search-provider-details {
    color: ${fg-0};
}

/* ---- Scrollbars ---- */
StScrollBar StBin#trough {
    background-color: transparent;
    border-radius: ${r-pill};
}

StScrollBar StButton#vhandle,
StScrollBar StButton#hhandle {
    background-color: ${fg-2@45};
    border: 3px solid transparent;
    border-radius: ${r-pill};
}

StScrollBar StButton#vhandle:hover,
StScrollBar StButton#hhandle:hover {
    background-color: ${fg-2@75};
}

StScrollBar StButton#vhandle:active,
StScrollBar StButton#hhandle:active {
    background-color: ${fg-1@80};
}

/* ---- Check boxes: no recolourable SVG, so a flat square with a light core ---- */
.check-box StBin {
    background-image: none;
    background-color: ${bg-2};
    border: 1px solid ${border};
    border-radius: ${r-xs};
    width: 18px;
    height: 18px;
    margin: 3px;
}

.check-box:focus StBin {
    background-image: none;
    border-color: ${focus};
}

.check-box:checked StBin,
.check-box:focus:checked StBin {
    background-image: none;
    background-color: ${on-accent};
    border-color: ${accent-hi};
    box-shadow: inset 0 0 0 4px ${accent};
}

.check-box:focus:checked StBin {
    border-color: ${focus};
}

/* ---- Screenshot UI ---- */
.screenshot-ui-panel {
    background-gradient-direction: vertical;
    background-gradient-start: ${slab-top};
    background-gradient-end: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-bottom-color: ${lip};
    border-radius: ${r-slab};
    box-shadow: ${elev-4};
}

.screenshot-ui-type-button,
.screenshot-ui-show-pointer-button {
    background-color: ${tile};
    color: ${fg-0};
    border: 1px solid ${border};
    border-radius: ${r-lg};
}

.screenshot-ui-type-button:hover,
.screenshot-ui-show-pointer-button:hover {
    background-color: ${bg-3};
}

.screenshot-ui-type-button:focus,
.screenshot-ui-show-pointer-button:focus {
    border-color: ${focus};
    box-shadow: none !important;
}

.screenshot-ui-type-button:checked,
.screenshot-ui-show-pointer-button:checked {
    background-color: ${accent};
    color: ${on-accent};
    border-color: ${accent-hi};
}

.screenshot-ui-shot-cast-container {
    background-color: ${tile};
    border: 1px solid ${border};
}

.screenshot-ui-shot-cast-button:checked {
    background-color: ${accent};
    color: ${on-accent};
}

.screenshot-ui-capture-button {
    border: 4px ${fg-0};
}

.screenshot-ui-capture-button .screenshot-ui-capture-button-circle {
    background-color: ${fg-0};
}

.screenshot-ui-capture-button:hover .screenshot-ui-capture-button-circle,
.screenshot-ui-capture-button:focus .screenshot-ui-capture-button-circle {
    background-color: ${accent-text};
}

.screenshot-ui-capture-button:cast .screenshot-ui-capture-button-circle {
    background-color: ${danger};
}

.screenshot-ui-close-button {
    background-color: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
}

/* ---- Quick Settings bento: matte cards inside the 2-column slab ---- */
.quick-toggle .quick-toggle-icon {
    background-color: ${hover};
    border-radius: ${r-sm};
    padding: 5px;
    icon-size: 16px;
}

.quick-toggle:checked .quick-toggle-icon {
    background-color: ${on-accent@15};
}

.quick-slider {
    background-color: ${matte};
    border: 1px solid ${border};
    border-radius: ${r-lg};
    padding: ${sp-1} ${sp-2};
}

.quick-slider .slider-bin:focus {
    background-color: transparent;
    box-shadow: none !important;
    border: 1px solid ${focus};
}

.quick-settings-system-item {
    background-color: ${matte};
    border: 1px solid ${border};
    border-radius: ${r-lg};
    padding: ${sp-2} ${sp-3};
}

.quick-settings-system-item .power-item {
    font-family: ${font-mono};
    font-weight: ${fw-medium};
    color: ${fg-0};
}

.quick-toggle-menu {
    background-color: ${matte};
    border: 1px solid ${border};
    border-radius: ${r-lg};
}

.quick-toggle-menu .header .title {
    color: ${fg-0};
}

.quick-toggle-menu .header .subtitle {
    color: ${fg-2};
    font-family: ${font-mono};
}

/* ==============================================================================
 * 6. LOCK SCREEN & LOGIN
 * ============================================================================== */
#lockDialogGroup {
    background-color: ${bg-0};
}

.unlock-dialog,
.login-dialog {
    color: ${fg-0};
    font-family: ${font-sans};
}

.screen-shield-background {
    background: ${bg-0};
    box-shadow: none;
}

.unlock-dialog-clock {
    color: ${fg-0};
    spacing: ${sp-3};
}

.unlock-dialog-clock .unlock-dialog-clock-time {
    font-family: ${font-sans};
    font-size: 96px;
    font-weight: 200;
    letter-spacing: -4px;
    color: ${fg-0};
}

.unlock-dialog-clock .unlock-dialog-clock-date {
    font-family: ${font-mono};
    font-size: ${fs-body};
    font-weight: ${fw-medium};
    letter-spacing: ${ls-eyebrow};
    color: ${fg-1};
}

.unlock-dialog-clock .unlock-dialog-clock-hint {
    margin-top: ${sp-5};
    padding: ${sp-1} ${sp-4};
    border: 1px solid ${gold-line};
    border-radius: ${r-pill};
    font-family: ${font-mono};
    font-size: ${fs-eyebrow};
    font-weight: ${fw-medium};
    letter-spacing: ${ls-eyebrow};
    color: ${fg-1};
}

.login-dialog .user-widget .user-widget-label,
.unlock-dialog .user-widget .user-widget-label {
    color: ${fg-0};
    font-size: ${fs-title};
    font-weight: ${fw-semibold};
}

.login-dialog .user-widget .user-icon,
.unlock-dialog .user-widget .user-icon {
    background-color: ${tile};
    color: ${gold-text};
    border: 1px solid ${gold-line};
    border-radius: ${r-pill};
}

.login-dialog .caps-lock-warning-label,
.login-dialog .login-dialog-message-warning,
.unlock-dialog .caps-lock-warning-label,
.unlock-dialog .login-dialog-message-warning {
    color: ${warning};
}

.login-dialog-message {
    color: ${fg-1};
}

.login-dialog-prompt-layout {
    spacing: ${sp-3};
}

.login-dialog-prompt-entry,
.login-dialog .login-dialog-prompt-entry,
.unlock-dialog .login-dialog-prompt-entry {
    background-color: ${bg-2};
    color: ${fg-0};
    border: 1px solid ${border};
    border-radius: ${r-sm};
    padding: ${sp-2} ${sp-3};
    font-family: ${font-sans};
    font-size: ${fs-body-lg};
}

.login-dialog-prompt-entry:hover,
.unlock-dialog .login-dialog-prompt-entry:hover {
    background-color: ${bg-2};
    border-color: ${gold-faint};
}

.login-dialog-prompt-entry:focus,
.login-dialog .login-dialog-prompt-entry:focus,
.unlock-dialog .login-dialog-prompt-entry:focus {
    background-color: ${bg-2};
    color: ${fg-0};
    border-color: ${focus};
    box-shadow: 0 0 6px ${ring-glow} !important;
}

.login-dialog-button.cancel-button,
.login-dialog-button.switch-user-button,
.login-dialog-button.login-dialog-auth-menu-button,
.login-dialog-button.login-dialog-session-list-button,
.unlock-dialog .button,
.unlock-dialog .icon-button {
    background-color: ${tile};
    color: ${fg-0};
    border: 1px solid ${border};
    border-radius: ${r-pill};
}

.login-dialog-button.cancel-button:hover,
.login-dialog-button.switch-user-button:hover,
.login-dialog-button.login-dialog-auth-menu-button:hover,
.login-dialog-button.login-dialog-session-list-button:hover,
.unlock-dialog .button:hover,
.unlock-dialog .icon-button:hover {
    background-color: ${bg-3};
}

.login-dialog-button.cancel-button:focus,
.login-dialog-button.switch-user-button:focus,
.login-dialog-button.login-dialog-auth-menu-button:focus,
.login-dialog-button.login-dialog-session-list-button:focus,
.unlock-dialog .button:focus,
.unlock-dialog .icon-button:focus {
    border-color: ${focus};
    box-shadow: none !important;
}

.login-dialog-auth-list-item {
    color: ${fg-1};
    border-radius: ${r-md};
}

.login-dialog-auth-list-item:focus,
.login-dialog-auth-list-item:selected {
    background-color: ${sel};
    color: ${accent-text};
}

.login-dialog-user-list-view .login-dialog-user-list .login-dialog-user-list-item {
    background-color: ${matte};
    color: ${fg-0};
    border: 1px solid ${border};
    border-radius: ${r-md};
    padding: ${sp-2};
}

.login-dialog-user-list-view .login-dialog-user-list .login-dialog-user-list-item:hover {
    background-color: ${tile};
    border-color: ${gold-faint};
}

.login-dialog-user-list-view .login-dialog-user-list .login-dialog-user-list-item:selected,
.login-dialog-user-list-view .login-dialog-user-list .login-dialog-user-list-item:focus {
    background-color: ${sel};
    color: ${fg-0};
    border-color: ${focus};
    box-shadow: none !important;
}

.login-dialog-user-list-view .login-dialog-user-list .login-dialog-user-list-item .login-dialog-timed-login-indicator {
    background-color: ${gold};
}

.login-dialog-not-listed-label {
    color: ${fg-1};
}

.login-dialog-not-listed-button {
    border-radius: ${r-md};
}

.unlock-dialog-notifications-container .notification,
.unlock-dialog-notifications-container .unlock-dialog-notification-source {
    background-color: ${glass-strong};
    color: ${fg-0};
    border: 1px solid ${border};
    border-top-color: ${gold-line};
    border-radius: ${r-md};
}

.unlock-dialog-notification-count-text {
    color: ${on-accent};
    background-color: ${accent};
    font-family: ${font-mono};
}
