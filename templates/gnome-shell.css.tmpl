/* ==============================================================================
 * 8. OVERVIEW WORKSPACE - stock draws the wallpaper in a 30px rounded box with a
 * dark drop shadow (the large rectangle behind the thumbnails, and the same box
 * for the neighbouring workspace peeking in at the screen edge).
 * ============================================================================== */
.workspace-background {
    border-radius: ${r-lg};
    box-shadow: none;
}

/* The overview backdrop: stock is a flat #222222 (Yaru) that shows wherever the
   wallpaper is not. The preset has blur-my-shell draw the dimmed wallpaper over it;
   the translucent fallback keeps the desktop visible when that component is off. */
#overviewGroup {
    background-color: ${bg-0@55};
}
